{
  "name": "supplier-command-center",
  "version": "0.1.0",
  "description": "AI-powered supplier portal: buyer requests, compliance and evidence-backed security reviews",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "nodemon --watch src/server --ext ts --exec tsx src/server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json --outDir dist/server",
    "start": "tsx src/server/index.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "tsx --test \"src/server/**/*.test.ts\"",
    "tprm:verify-samples": "tsx scripts/tprm/verify-samples.ts",
    "tprm:analyze-samples": "tsx scripts/tprm/analyze-samples.ts",
    "tprm:evidence-samples": "tsx scripts/tprm/evidence-samples.ts",
    "eval:tprm": "tsx scripts/tprm/eval.ts",
    "tprm:check-supabase": "tsx scripts/tprm/check-supabase.ts",
    "tprm:dev-api": "tsx scripts/tprm/dev-server.ts",
    "tprm:ui-check": "node scripts/tprm/ui-check.mjs",
    "tprm:e2e": "tsx scripts/tprm/e2e.ts",
    "tprm:record-demo": "node scripts/tprm/record-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.43.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.40.0",
    "@tiptap/extension-table": "^3.32.2",
    "@tiptap/extension-table-cell": "^3.32.2",
    "@tiptap/extension-table-header": "^3.32.2",
    "@tiptap/extension-table-row": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^20.14.2",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.395.0",
    "morgan": "^1.10.0",
    "pdfjs-dist": "6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.3.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "nodemon": "^3.1.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.3.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
